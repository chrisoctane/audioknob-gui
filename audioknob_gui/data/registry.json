{
  "knobs": [
    {
      "capabilities": {
        "apply": true,
        "read": true,
        "restore": true
      },
      "category": "permissions",
      "description": "[i] adds the current user to audio-related groups (audio, realtime, pipewire).\n[+] required for RT limits and low-latency device access.\n[-] grants extra device permissions and needs a reboot or log out/in.",
      "id": "audio_group_membership",
      "impl": {
        "kind": "group_membership",
        "params": {
          "groups": [
            "audio",
            "realtime",
            "pipewire"
          ]
        }
      },
      "requires_commands": [],
      "requires_groups": [],
      "requires_reboot": true,
      "requires_root": true,
      "risk_level": "low",
      "title": "Audio Groups"
    },
    {
      "capabilities": {
        "apply": true,
        "read": true,
        "restore": true
      },
      "category": "permissions",
      "depends_on": [
        "audio_group_membership"
      ],
      "description": "[i] sets PAM limits for the audio group (rtprio 95, memlock unlimited, nice -10).\n[+] lets audio apps use realtime priority and lock memory to avoid xruns.\n[-] requires log out/in or reboot; runaway RT apps can affect system responsiveness.",
      "id": "rt_limits_audio_group",
      "impl": {
        "kind": "pam_limits_audio_group",
        "params": {
          "lines": [
            "@audio   -  rtprio     95",
            "@audio   -  memlock    unlimited",
            "@audio   -  nice      -10"
          ],
          "path": "/etc/security/limits.d/99-audioknob-gui.conf"
        }
      },
      "requires_commands": [],
      "requires_groups": [
        "audio",
        "realtime"
      ],
      "requires_reboot": true,
      "requires_root": true,
      "risk_level": "low",
      "title": "RT Limits"
    },
    {
      "capabilities": {
        "apply": true,
        "read": true,
        "restore": true
      },
      "category": "irq",
      "description": "[i] disables irqbalance.\n[+] prevents IRQs moving between CPUs, which stabilizes audio latency and pinning.\n[-] IRQ distribution becomes static and can reduce throughput for some workloads.",
      "id": "irqbalance_disable",
      "impl": {
        "kind": "systemd_unit_toggle",
        "params": {
          "action": "disable_now",
          "unit": "irqbalance.service"
        }
      },
      "requires_commands": [],
      "requires_groups": [],
      "requires_reboot": false,
      "requires_root": true,
      "risk_level": "medium",
      "title": "IRQ Balance"
    },
    {
      "capabilities": {
        "apply": true,
        "read": true,
        "restore": true
      },
      "category": "irq",
      "description": "[i] configures rtirq priorities and enables the rtirq service.\n[+] with threaded IRQs, higher IRQ thread priority reduces audio interrupt latency.\n[-] requires threaded IRQs (threadirqs or RT kernel) to have effect and can deprioritize other IRQs.",
      "id": "rtirq_enable",
      "impl": {
        "kind": "rtirq_config",
        "params": {
          "high_list": [
            "snd",
            "usb"
          ],
          "name_list": [
            "snd",
            "usb"
          ],
          "prio_decr": 5,
          "prio_high": 90,
          "unit": "rtirq.service"
        }
      },
      "requires_commands": [
        "rtirq"
      ],
      "requires_groups": [],
      "requires_reboot": false,
      "requires_root": true,
      "risk_level": "medium",
      "title": "RT IRQ"
    },
    {
      "capabilities": {
        "apply": true,
        "read": true,
        "restore": true
      },
      "category": "irq",
      "depends_on": [
        "irqbalance_disable"
      ],
      "description": "[i] pins IRQs for selected audio devices to chosen cores and sweeps other IRQs off audio cores.\n[+] isolates audio interrupts to reduce jitter.\n[-] USB devices share controller IRQs; requires irqbalance off; poor choices can shift IRQ load.",
      "id": "irq_pinning",
      "impl": {
        "kind": "irq_affinity",
        "params": {
          "cpu_cores": "0,1",
          "device_keys": [],
          "persist_state_path": "/var/lib/audioknob-gui/state.json",
          "persist_unit": "audioknob-irq-pinning.service",
          "persist_unit_path": "/etc/systemd/system/audioknob-irq-pinning.service"
        }
      },
      "requires_commands": [],
      "requires_groups": [],
      "requires_reboot": false,
      "requires_root": true,
      "risk_level": "medium",
      "title": "IRQ Pinning"
    },
    {
      "capabilities": {
        "apply": true,
        "read": true,
        "restore": true
      },
      "category": "irq",
      "description": "[i] sets irqbalance banned CPUs policy (IRQBALANCE_BANNED_CPULIST).\n[r] configure before apply.\n[+] keeps irqbalance from moving IRQs onto selected audio CPUs.\n[-] wrong bans can concentrate IRQ load.",
      "id": "irqbalance_banned_cpulist",
      "impl": {
        "kind": "sysctl_conf",
        "params": {
          "lines": [
