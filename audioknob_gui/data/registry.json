      "category": "permissions",
      "description": "[i] adds the current user to audio-related groups (audio, realtime, pipewire).\n[+] required for RT limits and low-latency device access.\n[-] grants extra device permissions and needs a reboot or log out/in.",
      "id": "audio_group_membership",
      "impl": {
        "kind": "group_membership",
        "params": {
          "groups": [
            "audio",
            "realtime",
            "pipewire"
          ]
        }
      },
      "requires_commands": [],
      "requires_groups": [],
      "requires_reboot": true,
      "requires_root": true,
      "risk_level": "low",
      "title": "Audio Groups"
    },
    {
      "capabilities": {
        "apply": true,
        "read": true,
        "restore": true
      },
      "category": "permissions",
      "depends_on": [
        "audio_group_membership"
      ],
      "description": "[i] sets PAM limits for the audio group (rtprio 95, memlock unlimited, nice -10).\n[+] lets audio apps use realtime priority and lock memory to avoid xruns.\n[-] requires log out/in or reboot; runaway RT apps can affect system responsiveness.",
      "id": "rt_limits_audio_group",
      "impl": {
        "kind": "pam_limits_audio_group",
        "params": {
          "lines": [
            "@audio   -  rtprio     95",
            "@audio   -  memlock    unlimited",
            "@audio   -  nice      -10"
          ],
          "path": "/etc/security/limits.d/99-audioknob-gui.conf"
        }
      },
      "requires_commands": [],
      "requires_groups": [
        "audio",
        "realtime"
      ],
      "requires_reboot": true,
      "requires_root": true,
      "risk_level": "low",
      "title": "RT Limits"
    },
    {
      "capabilities": {
