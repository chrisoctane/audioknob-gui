      "impl": {
        "kind": "qjackctl_server_prefix",
        "params": {
          "cpu_cores": "0,1",
          "ensure_priority": true,
          "ensure_rt": true,
          "path": "~/.config/rncbc.org/QjackCtl.conf"
        }
