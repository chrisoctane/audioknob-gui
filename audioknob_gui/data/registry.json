    {
      "capabilities": {
        "apply": true,
        "read": true,
        "restore": true
      },
      "category": "irq",
      "depends_on": [
        "irqbalance_disable"
      ],
      "description": "[i] pins IRQs for selected audio devices to chosen cores and sweeps other IRQs off audio cores.\n[+] isolates audio interrupts to reduce jitter.\n[-] USB devices share controller IRQs; requires irqbalance off; poor choices can shift IRQ load.",
      "id": "irq_pinning",
      "impl": {
        "kind": "irq_affinity",
        "params": {
          "cpu_cores": "0,1",
          "device_keys": [],
          "persist_state_path": "/var/lib/audioknob-gui/state.json",
          "persist_unit": "audioknob-irq-pinning.service",
          "persist_unit_path": "/etc/systemd/system/audioknob-irq-pinning.service"
        }
      },
      "requires_commands": [],
      "requires_groups": [],
      "requires_reboot": false,
      "requires_root": true,
      "risk_level": "medium",
      "title": "IRQ Pinning"
